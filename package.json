{
  "name": "dsh-deep-think",
  "version": "0.5.1",
  "description": "Measure how much an agent thinks before it acts. Parses DeepSeek Harness session logs and reports thinking-before-acting, eager-acting rate and unsourced-claim rate; three runtime switchable modes (off/warn/reject) decide whether a non-compliant answer is merely logged or sent back for a redo.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "deep-think": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/types/analyze.d.ts",
      "default": "./lib/core/analyze.js"
    },
    "./intercept": {
      "types": "./lib/types/intercept.d.ts",
      "default": "./lib/core/intercept.js"
    },
    "./session": {
      "types": "./lib/types/session.d.ts",
      "default": "./lib/core/session.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.en.md",
    "README.md",
    "cordis.patch.yml",
    "lib",
    "lib/client.js"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "test": "node test/verify.mjs",
    "report": "node lib/cli.js",
    "test:client": "node test/validate-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.8",
      "verified": true,
      "verifiedOn": "2026-11-13, DSH desktop 0.2.0-rc.2",
      "note": "CLI、工具注册、客户端设置区块的宿主路由均已在真实 DSH 桌面 0.2.0-rc.2 验证（工具数 169→170；/api/dsh-deep-think/mode 实测可切换 off/warn/reject）。拦截（reject）语义实测会造成 turn 延长，默认 off，自行开启需确认误报率。"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent",
    "reasoning",
    "thinking",
    "observability",
    "eval",
    "guardrail"
  ],
  "license": "MIT"
}
